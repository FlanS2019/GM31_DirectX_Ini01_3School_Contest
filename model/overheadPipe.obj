# overheadPipe.obj -- procedurally generated placeholder (no
# downloaded asset needed -- see overheadPipe.h). Two parallel
# horizontal pipes running along local X, 3.4m long. Local origin is
# the pipes' own centerline reference point (not a floor-level
# base like Crate/Generator/PumpUnit) -- callers position it near a
# ceiling and use yRotation to run it along world X or world Z, same
# convention as SpawnIvy's wallYRotation.
mtllib overheadPipe.mtl
