# Debris_Stick.obj -- procedurally generated placeholder (no texture on
# hand, same reasoning as Crate/Ivy -- see debris.h). A slightly bent
# plank/branch lying flat on the floor: local Y=0 is its underside (rests
# directly on the floor with no position offset needed), length runs along
# local X from 0 to 1.0, thickness ~0.05m along Y.
# Every face vertex is written as v/vt/vn (this engine's OBJ loader
# (modelRenderer.cpp) always expects the full triplet and does not
# tolerate a bare vertex-only index).
mtllib Debris_Stick.mtl
usemtl Wood
