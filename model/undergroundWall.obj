# undergroundWall.obj -- procedurally generated placeholder (no
# downloaded asset needed -- see undergroundWall.h). Same shape/pivot
# convention as box.obj (local X=[-1,1], Y=[0,2], Z=[-1,1]) so it
# drops into Box::Draw()'s existing scale/position math unchanged --
# only the material differs. Plain cube, no bevel (box.obj has a
# slight Blender bevel that isn't visible at wall/ceiling scale).
mtllib undergroundWall.mtl
