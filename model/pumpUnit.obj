# pumpUnit.obj -- procedurally generated placeholder (no downloaded
# asset needed -- see pumpUnit.h). Concrete plinth + green motor
# housing + pipe stub + a small raised gauge dial, echoing the
# reference photo's green industrial pump units. Local origin at
# floor level (base), same convention as Crate/Stool/Generator --
# PumpUnit::Draw() uses m_Position directly with no pivot shift.
# Roughly 0.7m wide x 0.9m tall x 0.7m deep.
mtllib pumpUnit.mtl
