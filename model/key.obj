# Simple unit-cube placeholder for the STEP2 Key pickup.
# Same local convention as box.obj: X/Z centered in [-1,1], Y from 0 (base)
# to 2 (top) -- Key::Draw() offsets by -m_Scale.y the same way box.cpp does,
# so GetPosition() reads as this object's center everywhere else in the code.
mtllib key.mtl
o KeyCube
v -1.000000 0.000000 -1.000000
v  1.000000 0.000000 -1.000000
v  1.000000 0.000000  1.000000
v -1.000000 0.000000  1.000000
v -1.000000 2.000000 -1.000000
v  1.000000 2.000000 -1.000000
v  1.000000 2.000000  1.000000
v -1.000000 2.000000  1.000000
vt 0.000000 0.000000
vn 0.000000 -1.000000 0.000000
vn 0.000000 1.000000 0.000000
vn 0.000000 0.000000 -1.000000
vn 0.000000 0.000000 1.000000
vn -1.000000 0.000000 0.000000
vn 1.000000 0.000000 0.000000
usemtl Solid
f 1/1/1 2/1/1 3/1/1 4/1/1
f 8/1/2 7/1/2 6/1/2 5/1/2
f 1/1/3 2/1/3 6/1/3 5/1/3
f 3/1/4 4/1/4 8/1/4 7/1/4
f 4/1/5 1/1/5 5/1/5 8/1/5
f 2/1/6 3/1/6 7/1/6 6/1/6
